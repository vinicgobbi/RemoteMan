<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- runner nativo (Microsoft.Testing.Platform), exigido pelo dotnet test do .NET 10 -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O app é WinUI (não referenciável por um projeto de testes comum). Os testes compilam
      apenas os arquivos puros, sem dependência de interface.
    -->
    <Compile Include="..\RemoteMan\Models\ConnectionProtocol.cs" Link="App\ConnectionProtocol.cs" />
    <Compile Include="..\RemoteMan\Models\ConnectionAddress.cs" Link="App\ConnectionAddress.cs" />
    <Compile Include="..\RemoteMan\Models\ImportedConnection.cs" Link="App\ImportedConnection.cs" />
    <Compile Include="..\RemoteMan\Models\SharedCredential.cs" Link="App\SharedCredential.cs" />
    <Compile Include="..\RemoteMan\Services\Importers\*.cs" Link="App\Importers\%(Filename)%(Extension)" />
    <Compile Include="..\RemoteMan\Services\SshArguments.cs" Link="App\SshArguments.cs" />
    <Compile Include="..\RemoteMan\Services\SshTunnels.cs" Link="App\SshTunnels.cs" />
    <Compile Include="..\RemoteMan\Models\SftpClientKind.cs" Link="App\SftpClientKind.cs" />
    <Compile Include="..\RemoteMan\Services\SftpArguments.cs" Link="App\SftpArguments.cs" />
    <Compile Include="..\RemoteMan\Services\StatusTransitions.cs" Link="App\StatusTransitions.cs" />
    <Compile Include="..\RemoteMan\Services\UpdateRelease.cs" Link="App\UpdateRelease.cs" />
    <Compile Include="..\RemoteMan\Services\QuickSearch.cs" Link="App\QuickSearch.cs" />
    <Compile Include="..\RemoteMan\Services\RdpFileBuilder.cs" Link="App\RdpFileBuilder.cs" />
  </ItemGroup>

</Project>
