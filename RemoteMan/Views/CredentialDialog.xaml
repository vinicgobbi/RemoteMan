<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RemoteMan.Views.CredentialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonText="Salvar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="Primary_Click"
    Opened="Dialog_Opened">

    <StackPanel Width="400" Spacing="16">
        <TextBox
            x:Name="NameBox"
            Header="Nome"
            PlaceholderText="Ex.: Administrador do domínio"
            TextChanged="Name_TextChanged" />
        <TextBox
            x:Name="UserBox"
            Header="Usuário"
            PlaceholderText="usuario ou DOMINIO\usuario"
            IsSpellCheckEnabled="False" />
        <PasswordBox x:Name="PasswordInput" Header="Senha" />
        <TextBlock
            Style="{StaticResource SecondaryCaptionStyle}"
            TextWrapping="Wrap"
            Text="A senha fica no Gerenciador de Credenciais do Windows. Trocar a senha aqui vale para todas as conexões que usam esta credencial." />
    </StackPanel>
</ContentDialog>
