<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RemoteMan.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:RemoteMan.Models"
    xmlns:h="using:RemoteMan.Helpers"
    xmlns:c="using:RemoteMan.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- "Recentes" desce para baixo de "Favoritos" -->
                        <Setter Target="SecondColumn.Width" Value="0" />
                        <Setter Target="RecentCard.(Grid.Column)" Value="0" />
                        <Setter Target="RecentCard.(Grid.Row)" Value="1" />
                        <Setter Target="ListsGrid.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- coluna com largura máxima, presa à esquerda (não centraliza em janelas largas) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1164" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}">

                <!-- Cabeçalho -->
                <Grid ColumnSpacing="8" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Início" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Conexão rápida (Ctrl+K)"
                        Click="QuickConnect_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Conexão rápida" />
                            <TextBlock Text="Ctrl+K" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.Main.CheckStatusCommand}"
                        IsEnabled="{x:Bind h:Ui.Not(ViewModel.Main.IsChecking), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Verificar status" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Nova conexão (Ctrl+N)"
                        Click="NewConnection_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Nova conexão" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Estado vazio -->
                <Border Style="{StaticResource CardStyle}" Padding="32" Visibility="{x:Bind h:Ui.CollapsedIfAny(ViewModel.TotalCount), Mode=OneWay}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE703;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Nenhuma conexão cadastrada" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Use “Nova conexão” para adicionar seu primeiro servidor RDP ou SSH." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Resumo: status dos servidores + contagens -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.VisibleIfAny(ViewModel.TotalCount), Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE774;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="{x:Bind h:Ui.CollapsedIf(ViewModel.Main.IsChecking), Mode=OneWay}" />
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.Main.IsChecking, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Main.StatusSummary, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap">
                                <Run Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{x:Bind h:Ui.LastCheckText(ViewModel.Main.LastCheckedAt, ViewModel.Main.IsChecking), Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Favoritos e Recentes -->
                <Grid x:Name="ListsGrid" ColumnSpacing="{StaticResource SectionSpacing}" RowSpacing="{StaticResource SectionSpacing}" Visibility="{x:Bind h:Ui.VisibleIfAny(ViewModel.TotalCount), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="Favoritos" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <TextBlock
                                Text="Abra uma conexão e clique na estrela para fixá-la aqui."
                                Style="{StaticResource SecondaryTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind h:Ui.CollapsedIfAny(ViewModel.Favorites.Count), Mode=OneWay}" />
                            <ListView Style="{StaticResource ClickableListStyle}" ItemsSource="{x:Bind ViewModel.Favorites}" ItemClick="Item_Click">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="m:Connection">
                                        <c:ConnectionItem Connection="{x:Bind}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RecentCard" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Recentes" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <TextBlock
                                Text="As conexões que você abrir aparecem aqui."
                                Style="{StaticResource SecondaryTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind h:Ui.CollapsedIfAny(ViewModel.Recent.Count), Mode=OneWay}" />
                            <ListView Style="{StaticResource ClickableListStyle}" ItemsSource="{x:Bind ViewModel.Recent}" ItemClick="Item_Click">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="m:Connection">
                                        <c:ConnectionItem
                                            Connection="{x:Bind}"
                                            Detail="{x:Bind h:Ui.RelativeTime(LastConnected), Mode=OneWay}"
                                            ShowFavorite="{x:Bind IsFavorite, Mode=OneWay}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
