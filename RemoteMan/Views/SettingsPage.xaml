<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RemoteMan.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:RemoteMan.Helpers"
    xmlns:c="using:RemoteMan.Controls"
    xmlns:m="using:RemoteMan.Models"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <!-- coluna com largura máxima, presa à esquerda (não centraliza em janelas largas) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1164" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}">

                <TextBlock Text="Configurações" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,8" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Aparência" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <c:FieldRow Label="Efeito de fundo" Description="Material nativo do Windows 11 aplicado à janela.">
                            <c:FieldRow.Action>
                                <ComboBox x:Name="BackdropBox" MinWidth="220" SelectionChanged="Backdrop_SelectionChanged">
                                    <ComboBoxItem Content="Mica" ToolTipService.ToolTip="Tingido sutil com as cores do papel de parede" />
                                    <ComboBoxItem Content="Mica Alt" ToolTipService.ToolTip="Variante do Mica com mais contraste" />
                                    <ComboBoxItem Content="Acrílico (desfoque)" ToolTipService.ToolTip="Translúcido: mostra, desfocado, o que está atrás da janela" />
                                </ComboBox>
                            </c:FieldRow.Action>
                        </c:FieldRow>
                        <TextBlock
                            x:Name="BackdropNote"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Credenciais compartilhadas" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionStyle}"
                                    TextWrapping="Wrap"
                                    Text="Usuário e senha usados por várias conexões. Escolha a credencial em “Editar” de cada conexão." />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="NewCredential_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" Style="{StaticResource ButtonIconStyle}" />
                                    <TextBlock Text="Nova credencial" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Credentials}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:SharedCredential">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8D7;" FontSize="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind h:Ui.CredentialDetails(FullUsername, Id)}" Style="{StaticResource SecondaryCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Editar" Tag="{x:Bind}" Click="EditCredential_Click">
                                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource ButtonIconStyle}" />
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Excluir" Tag="{x:Bind}" Click="DeleteCredential_Click">
                                            <FontIcon Glyph="&#xE74D;" Style="{StaticResource ButtonIconStyle}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Monitoramento" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <c:FieldRow Label="Monitorar servidores" Description="Verifica o status periodicamente e avisa quando um favorito cai ou volta. Funciona com o app aberto.">
                            <c:FieldRow.Action>
                                <ToggleSwitch x:Name="MonitorSwitch" Style="{StaticResource RowToggleSwitchStyle}" Toggled="Monitor_Toggled" />
                            </c:FieldRow.Action>
                        </c:FieldRow>
                        <c:FieldRow Label="Intervalo">
                            <c:FieldRow.Action>
                                <ComboBox x:Name="MonitorIntervalBox" MinWidth="160" SelectionChanged="MonitorInterval_SelectionChanged">
                                    <ComboBoxItem Content="1 minuto" Tag="1" />
                                    <ComboBoxItem Content="5 minutos" Tag="5" />
                                    <ComboBoxItem Content="15 minutos" Tag="15" />
                                    <ComboBoxItem Content="30 minutos" Tag="30" />
                                </ComboBox>
                            </c:FieldRow.Action>
                        </c:FieldRow>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SFTP" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <c:FieldRow
                            x:Name="SftpClientRow"
                            Label="Cliente SFTP"
                            Description="Aberto por “Abrir SFTP” nas conexões SSH, já conectado ao servidor.">
                            <c:FieldRow.Action>
                                <ComboBox x:Name="SftpClientBox" MinWidth="220" SelectionChanged="SftpClient_SelectionChanged" />
                            </c:FieldRow.Action>
                        </c:FieldRow>
                        <ContentPresenter x:Name="SftpDownloads" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Atualizações" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <c:FieldRow Label="Verificar ao abrir" Description="Consulta o GitHub no máximo uma vez por dia.">
                            <c:FieldRow.Action>
                                <ToggleSwitch x:Name="CheckUpdatesSwitch" Style="{StaticResource RowToggleSwitchStyle}" Toggled="CheckUpdates_Toggled" />
                            </c:FieldRow.Action>
                        </c:FieldRow>
                        <c:FieldRow Label="Versão instalada" Value="{x:Bind Version}">
                            <c:FieldRow.Action>
                                <Button x:Name="CheckNowButton" Click="CheckNow_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" Style="{StaticResource ButtonIconStyle}" />
                                        <TextBlock Text="Verificar agora" />
                                    </StackPanel>
                                </Button>
                            </c:FieldRow.Action>
                        </c:FieldRow>
                        <TextBlock x:Name="CheckResultText" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ambiente" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <c:FieldRow Label="Usuário do Windows" Value="{x:Bind WindowsUser}" />
                        <c:FieldRow Label="OpenSSH" Value="{x:Bind h:Ui.OrNotFound(SshPath)}" />
                        <c:FieldRow Label="Windows Terminal" Value="{x:Bind h:Ui.FoundText(HasWindowsTerminal)}" />
                        <c:FieldRow Label="Arquivo de conexões" Value="{x:Bind DataFilePath}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sobre as senhas" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="As senhas ficam no Gerenciador de Credenciais do Windows, protegidas pela sua conta. O arquivo de conexões não guarda nenhuma senha." />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="Em conexões SSH sem chave privada, a senha salva é copiada para a área de transferência ao conectar (fora do histórico do Win+V). Cole no terminal com o botão direito." />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="O mesmo vale para “Abrir SFTP”: a senha nunca é passada na linha de comando do cliente; ela fica na área de transferência para colar quando ele pedir." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sobre" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <c:FieldRow Label="Aplicativo" Value="RemoteMan" />
                        <c:FieldRow Label="Versão" Value="{x:Bind Version}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
