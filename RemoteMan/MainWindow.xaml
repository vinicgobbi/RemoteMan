<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RemoteMan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:RemoteMan.Models"
    xmlns:vm="using:RemoteMan.ViewModels"
    xmlns:h="using:RemoteMan.Helpers"
    Title="RemoteMan">

    <Grid>
        <Grid.Resources>
            <CollectionViewSource x:Name="ConnectionsSource" IsSourceGrouped="True" />
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título customizada -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE703;" FontSize="16" />
                <TextBlock Text="RemoteMan" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Painel esquerdo: lista ===== -->
            <Grid Padding="12,4,12,12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DropDownButton HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Nova conexão" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Área de trabalho remota (RDP)" Command="{x:Bind ViewModel.NewRdpCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Terminal SSH" Command="{x:Bind ViewModel.NewSshCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE756;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <AutoSuggestBox
                    Grid.Row="1"
                    PlaceholderText="Buscar por nome, host, grupo…"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                    TextChanged="SearchBox_TextChanged" />

                <ListView
                    x:Name="ConnectionList"
                    Grid.Row="2"
                    SelectionMode="Single"
                    SelectionChanged="ConnectionList_SelectionChanged"
                    DoubleTapped="ConnectionList_DoubleTapped">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:ConnectionGroup">
                                    <TextBlock Text="{x:Bind Key}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:Connection">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind h:Ui.ProtocolGlyph(Protocol)}" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind h:Ui.Endpoint(Host, Port), Mode=OneWay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ===== Painel direito: detalhes ===== -->
            <Grid
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Nada selecionado -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind h:Ui.CollapsedIfNotNull(ViewModel.Selected), Mode=OneWay}">
                    <FontIcon Glyph="&#xE703;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="Selecione uma conexão ou crie uma nova"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Editor -->
                <Grid Visibility="{x:Bind h:Ui.VisibleIfNotNull(ViewModel.Selected), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho + ações -->
                    <Grid Padding="32,24,32,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon
                                Glyph="{x:Bind h:Ui.ProtocolGlyph(ViewModel.Selected.Protocol), Mode=OneWay}"
                                FontSize="22"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind h:Ui.Summary(ViewModel.Selected.Protocol, ViewModel.Selected.Host, ViewModel.Selected.Port), Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConnectCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Conectar" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.SaveCommand}" ToolTipService.ToolTip="Salvar (Ctrl+S)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="Salvar" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.DuplicateCommand}" ToolTipService.ToolTip="Duplicar">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <Button Click="Delete_Click" ToolTipService.ToolTip="Excluir">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="32,0,32,24">
                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

                            <!-- Geral -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Geral" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="Nome" Text="{x:Bind ViewModel.Selected.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Header="Grupo" PlaceholderText="Ex.: Produção" Text="{x:Bind ViewModel.Selected.Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="Host / IP" PlaceholderText="servidor.empresa.local" Text="{x:Bind ViewModel.Selected.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <NumberBox
                                            Grid.Column="1"
                                            Header="Porta"
                                            Minimum="1"
                                            Maximum="65535"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.Selected.Port, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Autenticação -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Autenticação" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                    <CheckBox
                                        Content="Usar o usuário do Windows (sessão atual)"
                                        Visibility="{x:Bind h:Ui.RdpOnly(ViewModel.Selected.Protocol), Mode=OneWay}"
                                        IsChecked="{x:Bind ViewModel.Selected.UseWindowsCredentials, Mode=TwoWay}" />
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind h:Ui.WindowsCredentials(ViewModel.Selected.Protocol, ViewModel.Selected.UseWindowsCredentials), Mode=OneWay}"
                                        Text="{x:Bind h:Ui.WindowsUserInfo()}" />

                                    <Grid ColumnSpacing="12" Visibility="{x:Bind h:Ui.ManualCredentials(ViewModel.Selected.Protocol, ViewModel.Selected.UseWindowsCredentials), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="Usuário" Text="{x:Bind ViewModel.Selected.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Header="Domínio"
                                            PlaceholderText="Opcional"
                                            Visibility="{x:Bind h:Ui.RdpOnly(ViewModel.Selected.Protocol), Mode=OneWay}"
                                            Text="{x:Bind ViewModel.Selected.Domain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid ColumnSpacing="8" Visibility="{x:Bind h:Ui.ManualCredentials(ViewModel.Selected.Protocol, ViewModel.Selected.UseWindowsCredentials), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox
                                            Header="Senha (guardada no Gerenciador de Credenciais do Windows)"
                                            PlaceholderText="{x:Bind h:Ui.PasswordPlaceholder(ViewModel.HasSavedPassword), Mode=OneWay}"
                                            Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            ToolTipService.ToolTip="Copiar senha"
                                            Command="{x:Bind ViewModel.CopyPasswordCommand}">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Bottom"
                                            ToolTipService.ToolTip="Remover senha salva"
                                            Visibility="{x:Bind h:Ui.VisibleIf(ViewModel.HasSavedPassword), Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ClearPasswordCommand}">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </Grid>

                                    <Grid ColumnSpacing="8" Visibility="{x:Bind h:Ui.SshOnly(ViewModel.Selected.Protocol), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Header="Chave privada (opcional)"
                                            PlaceholderText="C:\Users\voce\.ssh\id_ed25519"
                                            Text="{x:Bind ViewModel.Selected.KeyFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Procurar…" Click="BrowseKey_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Opções RDP -->
                            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.RdpOnly(ViewModel.Selected.Protocol), Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Exibição e recursos" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <ToggleSwitch Header="Tela cheia" IsOn="{x:Bind ViewModel.Selected.FullScreen, Mode=TwoWay}" />
                                    <!-- Grid não tem IsEnabled (não é Control): o estado vai em cada NumberBox -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            Header="Largura"
                                            Minimum="640"
                                            Maximum="8192"
                                            SpinButtonPlacementMode="Compact"
                                            IsEnabled="{x:Bind h:Ui.Not(ViewModel.Selected.FullScreen), Mode=OneWay}"
                                            Value="{x:Bind ViewModel.Selected.DesktopWidth, Mode=TwoWay}" />
                                        <NumberBox
                                            Grid.Column="1"
                                            Header="Altura"
                                            Minimum="480"
                                            Maximum="8192"
                                            SpinButtonPlacementMode="Compact"
                                            IsEnabled="{x:Bind h:Ui.Not(ViewModel.Selected.FullScreen), Mode=OneWay}"
                                            Value="{x:Bind ViewModel.Selected.DesktopHeight, Mode=TwoWay}" />
                                    </Grid>
                                    <CheckBox Content="Usar todos os monitores" IsChecked="{x:Bind ViewModel.Selected.MultiMonitor, Mode=TwoWay}" />
                                    <CheckBox Content="Compartilhar área de transferência" IsChecked="{x:Bind ViewModel.Selected.RedirectClipboard, Mode=TwoWay}" />
                                    <CheckBox Content="Compartilhar unidades locais" IsChecked="{x:Bind ViewModel.Selected.RedirectDrives, Mode=TwoWay}" />
                                    <CheckBox Content="Sessão administrativa (/admin)" IsChecked="{x:Bind ViewModel.Selected.AdminSession, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Notas -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Notas" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="80"
                                        Text="{x:Bind ViewModel.Selected.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <InfoBar
                    Grid.Row="1"
                    Margin="32,0,32,16"
                    IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
