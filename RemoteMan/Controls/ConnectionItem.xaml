<?xml version="1.0" encoding="utf-8"?>
<!--
    Linha padrão de uma conexão, usada em todas as listas do app:
    status · ícone do protocolo · nome e endereço · detalhe opcional · botão Conectar.
-->
<UserControl
    x:Class="RemoteMan.Controls.ConnectionItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:RemoteMan.Helpers">

    <Grid Padding="0,6" ColumnSpacing="12" Background="Transparent">
        <!-- clique direito na linha (lista de conexões e dashboard) -->
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Conectar" Click="Connect_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Text="Abrir SFTP"
                    Click="OpenSftp_Click"
                    Visibility="{x:Bind h:Ui.SshOnly(Connection.Protocol), Mode=OneWay, FallbackValue=Collapsed}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Ellipse
            Style="{StaticResource StatusDotStyle}"
            Fill="{x:Bind h:Ui.StatusBrush(Connection.Status), Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind h:Ui.StatusText(Connection.Status), Mode=OneWay}" />

        <FontIcon
            Grid.Column="1"
            FontSize="16"
            Glyph="{x:Bind h:Ui.ProtocolGlyph(Connection.Protocol), Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind h:Ui.ProtocolLongName(Connection.Protocol), Mode=OneWay}" />

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Connection.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <TextBlock
                Style="{StaticResource SecondaryCaptionStyle}"
                Text="{x:Bind h:Ui.Endpoint(Connection.Host, Connection.Port), Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock
                Style="{StaticResource SecondaryCaptionStyle}"
                VerticalAlignment="Center"
                Text="{x:Bind Detail, Mode=OneWay}"
                Visibility="{x:Bind h:Ui.VisibleIfText(Detail), Mode=OneWay}" />
            <FontIcon
                Glyph="&#xE735;"
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                ToolTipService.ToolTip="Favorito"
                Visibility="{x:Bind h:Ui.VisibleIf(ShowFavorite), Mode=OneWay}" />
        </StackPanel>

        <Button
            Grid.Column="4"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="Conectar"
            Click="Connect_Click"
            DoubleTapped="Connect_DoubleTapped">
            <FontIcon Glyph="&#xE768;" FontSize="12" />
        </Button>
    </Grid>
</UserControl>
